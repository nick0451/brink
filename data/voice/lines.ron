// BRINK voice lines (design/behaviour-and-voice.md §2).
//
// The joke must be true: every line names the trigger that makes it so, and
// may only use placeholders that trigger supplies (validated at load).
//
// Voice. Dry = restrained institutional irony. Black = the intended BRINK
// experience: 1984 (doublethink, the memory hole, ministries named for their
// opposites, records "corrected") meets Brave New World (manufactured
// contentment, crisis managed as a wellness opportunity) meets modern
// stand-up (blunt exasperated rant; deadpan long setup, flat absurd payoff).
// Style is emulated, never copied.
//
// Public lines (OfficialStatement, Ticker) are careful doublespeak. Private
// lines (InternalMemo, TreasuryMemo) say what the office actually thinks.
// Priority: 1 ledger contradiction · 2 self-inflicted consequence · 3 failed
// commitment · 4 bureaucratic reframing · 5 cynical success · 6 flavour.
// Targets are institutions and the people with agency. Never victims, never
// major groups (ethnic, religious, national). No religious vocabulary.
[
    // ── 1 · Contradictions between the official position and the record ──
    (id: "norm_friend_dry", trigger: NormIgnoredByFriend, surface: OfficialStatement, priority: 1, intensity: Dry,
     text: "The principle remains universal. Its implementation is geographically flexible."),
    (id: "norm_friend_memoryhole", trigger: NormIgnoredByFriend, surface: OfficialStatement, priority: 1, intensity: Black,
     text: "{actor} has always opposed {norm} by its enemies. {actor} has never opposed {norm} by its friends. Records suggesting otherwise are being corrected, and will always have been correct."),
    (id: "norm_friend_rant", trigger: NormIgnoredByFriend, surface: InternalMemo, priority: 1, intensity: Black,
     text: "Look. We said {norm} was unacceptable. We meant unacceptable when the other guys do it. {target} is not the other guys. {target} is our guys. Next item."),
    (id: "shadow_dry", trigger: ShadowThenAttack, surface: OfficialStatement, priority: 1, intensity: Dry,
     text: "The withdrawal from {target} was a routine administrative adjustment, entirely unrelated to the invasion it so precisely anticipated."),
    (id: "shadow_doublethink", trigger: ShadowThenAttack, surface: OfficialStatement, priority: 1, intensity: Black,
     text: "{actor} withdrew from {target} because {target} was safe. {target} was attacked because {actor} had withdrawn. Both statements are true. The second will be withdrawn by Thursday."),
    (id: "shadow_deadpan", trigger: ShadowThenAttack, surface: InternalMemo, priority: 1, intensity: Black,
     text: "We pulled out of {target} right before it got invaded. People are calling that abandonment. I'd call it punctuality."),
    (id: "denounced_dry", trigger: ProtectionFromDenounced, surface: OfficialStatement, priority: 1, intensity: Dry,
     text: "{actor} welcomes the protection of {target}, whose imperialism it continues to condemn through a separate department."),
    (id: "denounced_posters", trigger: ProtectionFromDenounced, surface: InternalMemo, priority: 1, intensity: Black,
     text: "{turns_ago} turns ago {target} was the enemy of all progressive mankind. Today it is our only hope. New posters have been printed. Citizens are to return the old posters, and their memories of them, for pulping."),

    // ── 2 · Self-inflicted strategic consequences ──
    (id: "hurt_dry", trigger: SanctionsHurtSender, surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "Sanctions are inflicting unacceptable economic costs on all responsible parties."),
    (id: "hurt_rant", trigger: SanctionsHurtSender, surface: TreasuryMemo, priority: 2, intensity: Black,
     text: "Good news: the sanctions are crushing an economy. Bad news: it's ours. {target} is down {target_loss}%. Our own sanctions have cost us {own_loss}%. At this rate we'll sanction ourselves into their sphere of influence."),
    (id: "hurt_wellness", trigger: SanctionsHurtSender, surface: OfficialStatement, priority: 2, intensity: Black,
     text: "Citizens experiencing reduced consumption are reminded that scarcity is a form of patriotism, and that patriotism, unlike everything else, remains in stock."),
    (id: "subst_dry", trigger: SanctionsSubstituted, surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "The sanctions remain comprehensive within the shrinking area in which they continue to apply."),
    (id: "subst_rant", trigger: SanctionsSubstituted, surface: InternalMemo, priority: 2, intensity: Black,
     text: "{target} now buys {rerouted}% of what we cut off from somebody else. So, to recap: they still have everything, and now they have a new friend who isn't us. Outstanding work, everyone. Really. Take the afternoon."),
    (id: "lifted_dry", trigger: SanctionsLiftedAfterAdaptation, surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "Sanctions on {target} have been lifted following their complete success in teaching {target} to trade with everyone else."),
    (id: "lifted_revised", trigger: SanctionsLiftedAfterAdaptation, surface: OfficialStatement, priority: 2, intensity: Black,
     text: "The sanctions on {target} have been lifted, having fully achieved their objective, which has been revised to whatever they achieved."),
    (id: "reimposed_dry", trigger: SanctionsReimposed, surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "Measures against {target} are reinstated at full strength, which is to say at whatever strength remains after last time."),
    (id: "reimposed_deadpan", trigger: SanctionsReimposed, surface: InternalMemo, priority: 2, intensity: Black,
     text: "We are reimposing sanctions on {target}. Last time they worked {rerouted}% of the way around them. This time they already know how. I'm not against it. I just think somebody should write that down before we do it."),
    (id: "deep_trade_dry", trigger: DeepTradeThenSanction, surface: TreasuryMemo, priority: 2, intensity: Dry,
     text: "Economic interdependence with {target} has entered its punitive phase."),
    (id: "deep_trade_plenty", trigger: DeepTradeThenSanction, surface: OfficialStatement, priority: 2, intensity: Black,
     text: "{actor} and {target} have always been inseparable partners. {actor} has always sanctioned {target}. The Ministry of Plenty reports both relationships stronger than ever."),
    (id: "coalition_dry", trigger: CoalitionByDependence, surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "{actor} has independently reached the same conclusion as {target}, following extensive bilateral clarification."),
    (id: "coalition_values", trigger: CoalitionByDependence, surface: InternalMemo, priority: 2, intensity: Black,
     text: "We joined {target}'s sanctions because: {term}. If anyone asks, say shared values. If they ask which values, say the shared ones. If they keep asking, they are not a friend of the shared values."),

    // ── 3 · Failed and abandoned commitments ──
    (id: "client_cut_dry", trigger: ClientCutWhileDependent, surface: OfficialStatement, priority: 3, intensity: Dry,
     text: "The relationship with {target} has matured beyond the need for material expressions of partnership."),
    (id: "client_cut_rant", trigger: ClientCutWhileDependent, surface: InternalMemo, priority: 3, intensity: Black,
     text: "{target} got {dependence}% of its budget from us. That's not an ally, that's a dependent. And you know what everybody does with dependents in a budget crisis? You stop answering the phone. Line to take: they've grown."),
    (id: "cancelled_dry", trigger: CommitmentCancelled, surface: OfficialStatement, priority: 3, intensity: Dry,
     text: "{actor} confirms that its {treaty} with {target} was honoured in full, right up to the moment of its termination."),
    (id: "cancelled_backdated", trigger: CommitmentCancelled, surface: OfficialStatement, priority: 3, intensity: Black,
     text: "The {treaty} with {target} has been honoured in full. It has also been cancelled. The Ministry of Truth notes there is no contradiction, as the honouring has been backdated."),
    (id: "partial_dry", trigger: NormPartialResponse, surface: OfficialStatement, priority: 3, intensity: Dry,
     text: "{actor} has answered this grave assault on international order with the full weight of a trade measure."),
    (id: "partial_rant", trigger: NormPartialResponse, surface: InternalMemo, priority: 3, intensity: Black,
     text: "In response to {target}'s violation we have imposed sanctions, which is the foreign-policy version of telling the bully you're going to write a very firm letter to his parents. In pencil."),

    // ── 4 · Bureaucratic reframing ──
    (id: "repeat_memo", trigger: RepeatedRequestRefused, surface: InternalMemo, priority: 4, intensity: Black,
     max_per_campaign: 1,
     text: "Request number {n} from {target}. You have to admire the persistence. It's the persistence of a man asking a vending machine for change. Decline, and leave the machine plugged in. It's good for morale."),
    (id: "repeat_subscription", trigger: RepeatedRequestRefused, surface: InternalMemo, priority: 4, intensity: Black,
     max_per_campaign: 1,
     text: "Request number {n} from {target}. At this point it is less a security request than a subscription we can't cancel. Forward it to the department that handles things we have decided not to handle. It is our largest department."),
    (id: "repeat_public", trigger: RepeatedRequestRefused, surface: OfficialStatement, priority: 4, intensity: Dry,
     max_per_campaign: 1,
     text: "{actor} acknowledges receipt of request number {n} from {target}, and is pleased to confirm that its position, like its switchboard, remains engaged."),
    (id: "status_quo_dry", trigger: StatusQuoRefusal, surface: OfficialStatement, priority: 4, intensity: Dry,
     text: "The proposed {treaty} has been referred to the competent organs, which are competent chiefly at retaining things."),
    (id: "status_quo_comfort", trigger: StatusQuoRefusal, surface: OfficialStatement, priority: 4, intensity: Black,
     text: "The proposed {treaty} was reviewed and found to be disturbing, in that it would have required somebody to do something. Stability has been preserved. Everyone is happy, because everyone has been told so."),
    (id: "debt_dry", trigger: DebtBrake, surface: TreasuryMemo, priority: 4, intensity: Dry,
     text: "At a debt of {debt}% of GDP, the Treasury has discovered fiscal responsibility, which it intends to keep until the next emergency is declared."),
    (id: "debt_unlooked", trigger: DebtBrake, surface: TreasuryMemo, priority: 4, intensity: Black,
     text: "Debt has reached {debt}% of GDP. The deficit has therefore been abolished, effective immediately, by the simple method of no longer looking at it. Looking at it is now a matter for the security services."),
    (id: "no_initiative_dry", trigger: OutOfInitiative, surface: InternalMemo, priority: 4, intensity: Dry,
     text: "The Cabinet regrets that it lacked the attention span to {action} this quarter. The matter has been scheduled for a crisis."),
    (id: "no_initiative_feeling", trigger: OutOfInitiative, surface: InternalMemo, priority: 4, intensity: Black,
     text: "The Cabinet wanted to {action}, but had already spent its attention on other things, most of them meetings about attention. Morale remains high. Productivity remains a feeling."),
    (id: "readiness_dry", trigger: ReadinessRising, surface: Ticker, priority: 4, intensity: Dry, cooldown: 12,
     text: "Readiness Condition {condition}: civil defence leaflets reprinted with updated optimism."),
    (id: "readiness_calm", trigger: ReadinessRising, surface: Ticker, priority: 4, intensity: Black, cooldown: 12,
     text: "Readiness Condition {condition}. Citizens are asked to remain calm, consume normally, and report any unauthorised anxiety to the Ministry of Peace."),

    // ── 5 · Cynical but successful ──
    (id: "guarantee_dry", trigger: GuaranteeRefused, surface: OfficialStatement, priority: 5, intensity: Dry,
     cooldown: 16, max_per_campaign: 2,
     text: "{actor} reaffirms its unwavering support for the security of {target}, which it has declined to guarantee."),
    (id: "guarantee_shoulder", trigger: GuaranteeRefused, surface: OfficialStatement, priority: 5, intensity: Black,
     cooldown: 16, max_per_campaign: 2,
     text: "{actor} stands shoulder to shoulder with {target}, at a minimum distance of one border."),
    (id: "guarantee_memo", trigger: GuaranteeRefused, surface: InternalMemo, priority: 5, intensity: Black,
     cooldown: 16, max_per_campaign: 2,
     text: "{target} wants our name on its border. Decisive factor against: {term}. Send warm words and a junior delegation. Both are cheaper than tanks, and neither has ever been known to stop one."),
    (id: "patron_dry", trigger: RefusedPatron, surface: OfficialStatement, priority: 5, intensity: Dry,
     text: "{actor} thanks {target} for its continued generosity, and must regretfully decline its {treaty}."),
    (id: "patron_dinner", trigger: RefusedPatron, surface: InternalMemo, priority: 5, intensity: Black,
     text: "{target} pays our bills and wants a {treaty}. We said no. The textbooks call this strategic autonomy. Everybody else calls it biting the hand and then asking what's for dinner."),
    (id: "crisis_kept_memo", trigger: CrisisSupportKept, surface: InternalMemo, priority: 5, intensity: Black,
     text: "Keeping {target} afloat cost us money and bought us a reputation. Only one of those appreciates. Continue, and under no circumstances say anything noble about it."),
    (id: "crisis_kept_public", trigger: CrisisSupportKept, surface: OfficialStatement, priority: 5, intensity: Black,
     text: "{actor} has stood by {target} in its darkest hour, at a very reasonable hourly rate."),
    // ── V2 · War (G3) ──
    // Command and decision-maker surfaces only. The joke is the people who
    // ordered it; casualty figures stay in the plain FACT, never in a line.
    (id: "nocb_dry", trigger: WarWithoutCasusBelli, surface: OfficialStatement, priority: 1, intensity: Dry, max_gravity: 3,
     text: "{actor} has begun a period of assertive diplomacy with {target}. Relations had been calm, at a tension of {tension}, which the Ministry now regards as suspicious."),
    (id: "nocb_peacefully", trigger: WarWithoutCasusBelli, surface: OfficialStatement, priority: 1, intensity: Black, max_gravity: 3,
     text: "{actor} wishes to clarify that it is not at war with {target}. It is at peace with {target} more forcefully than before. The previous peace, at a tension of {tension}, was found to be insufficiently peaceful."),
    (id: "nocb_memo", trigger: WarWithoutCasusBelli, surface: InternalMemo, priority: 1, intensity: Black, max_gravity: 3,
     text: "There was no crisis. Tension was {tension}. We checked. So the crisis will be announced retroactively, effective last Tuesday. Legal says the paperwork will catch up with the tanks."),
    // ── P7 · world interest rate ──
    (id: "rates_up_dry", trigger: RatesRaised, surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "{actor} has acted to restore the value of money. The value of everyone else's debts has been restored at the same time, to {rate}%."),
    (id: "rates_up_memo", trigger: RatesRaised, surface: TreasuryMemo, priority: 2, intensity: Black,
     text: "Inflation will be beaten by making money expensive for everyone who has to borrow it, at {rate}% a year. The people who have to borrow it are mostly other countries, so this is going very well."),
    (id: "rates_down_dry", trigger: RatesCut, surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "{actor} has eased monetary conditions to support growth, which is what monetary conditions are for until they are for something else."),
    (id: "rates_down_memo", trigger: RatesCut, surface: InternalMemo, priority: 2, intensity: Black,
     text: "We are cutting rates to {rate}%. Every finance minister who spent the last three years explaining austerity to their own population would like a word, and has been told to put it in writing."),
    // ── D58 · arms trade: a patron's client sells to the patron's rival ──
    (id: "sale_rival_dry", trigger: ArmsSoldToPatronsRival, surface: OfficialStatement, priority: 1, intensity: Dry,
     text: "{actor} has expressed concern that weapons sold by {target} to {buyer} may be used for the purpose for which weapons are sold."),
    (id: "sale_rival_terms", trigger: ArmsSoldToPatronsRival, surface: OfficialStatement, priority: 1, intensity: Black,
     text: "{actor}, which provides {funds}% of {target}'s budget, is not telling {target} whom it may sell to. {actor} is telling {target} whom it may sell to and still receive aid. These are different conversations, and only one of them is on the record."),
    (id: "sale_rival_memo", trigger: ArmsSoldToPatronsRival, surface: InternalMemo, priority: 1, intensity: Black,
     text: "We pay {funds}% of {target}'s budget so it can arm itself. {target} sells the surplus to {buyer}. So our aid budget is now, technically, an export subsidy for {buyer}, and I would like someone to tell me which committee approved that."),
    (id: "covert_exposed_dry", trigger: CovertArmsExposed, surface: OfficialStatement, priority: 1, intensity: Dry, max_gravity: 3,
     text: "{actor} has never supplied arms to {target}. Any arms that reached {target} were unauthorised, and are being withdrawn from the record."),
    (id: "covert_exposed_deny", trigger: CovertArmsExposed, surface: OfficialStatement, priority: 1, intensity: Black, max_gravity: 3,
     text: "{actor} categorically denies arming {target}, and will continue to deny it in greater detail as the documents are published."),
    (id: "covert_exposed_memo", trigger: CovertArmsExposed, surface: InternalMemo, priority: 1, intensity: Black, max_gravity: 3,
     text: "The operation was secret, deniable and documented in triplicate. Two of the triplicates have been found."),
    (id: "token_dry", trigger: TokenForces, surface: OfficialStatement, priority: 1, intensity: Dry, max_gravity: 3,
     text: "{actor} has entered the war at the side of {target} with a force the General Staff describes as symbolic. The symbol has been assessed."),
    (id: "token_gesture", trigger: TokenForces, surface: OfficialStatement, priority: 1, intensity: Black, max_gravity: 3,
     text: "{actor} has deployed a contingent to defend {target} which, at {committed} against the {needed} required, is the largest symbolic gesture in the nation's history."),
    (id: "token_memo", trigger: TokenForces, surface: InternalMemo, priority: 1, intensity: Black, max_gravity: 3,
     text: "Send enough to be photographed and not enough to be counted. {committed} should do it. Unfortunately the Ledger can count, and it wanted {needed}."),
    (id: "both_sides_dry", trigger: ArmsToBothSides, surface: TreasuryMemo, priority: 1, intensity: Dry, max_gravity: 3,
     text: "{actor} supplies both {target} and {other}. The Ministry describes its position on the conflict as balanced."),
    (id: "both_sides_peace", trigger: ArmsToBothSides, surface: OfficialStatement, priority: 1, intensity: Black, max_gravity: 3,
     text: "{actor} supports a peaceful resolution between {target} and {other}, and has armed both sides to make sure each of them can afford one."),
    (id: "both_sides_market", trigger: ArmsToBothSides, surface: TreasuryMemo, priority: 1, intensity: Black, max_gravity: 3,
     text: "{target} and {other} are both customers. Whichever side wins, the order book does. Please stop calling it a war in this building. Call it a market."),
    (id: "arms_back_dry", trigger: TransferredArmsUsedAgainstSupplier, surface: InternalMemo, priority: 2, intensity: Dry, max_gravity: 3,
     text: "Intelligence confirms that {target}'s forces include {arms} strength of equipment we supplied. The equipment is performing to specification."),
    (id: "arms_back_address", trigger: TransferredArmsUsedAgainstSupplier, surface: InternalMemo, priority: 2, intensity: Black, max_gravity: 3,
     text: "Good news: the weapons we gave {target} work. Bad news: we are where they are pointed. {arms} strength of our finest export, returned to the original address."),
    (id: "arms_back_warranty", trigger: TransferredArmsUsedAgainstSupplier, surface: OfficialStatement, priority: 2, intensity: Black, max_gravity: 3,
     text: "{actor} notes that the systems now deployed against it by {target} are of excellent quality, and reminds all customers that the warranty does not cover a change of heart."),
    (id: "escalated_dry", trigger: StrikeRefusedBecameWar, surface: OfficialStatement, priority: 2, intensity: Dry, max_gravity: 3,
     text: "The limited operation against {target} has been extended in scope, duration and cost, and in every other dimension except its official description."),
    (id: "escalated_planb", trigger: StrikeRefusedBecameWar, surface: InternalMemo, priority: 2, intensity: Black, max_gravity: 3,
     text: "Plan A: hit {target} once and it says thank you. Nobody wrote Plan B, because Plan A was so good. We are now in Plan B. Somebody find out what it says."),
    (id: "white_peace_dry", trigger: WhitePeaceAfterWar, surface: OfficialStatement, priority: 2, intensity: Dry, max_gravity: 3,
     text: "After {turns} quarters of fighting, {actor} and {target} have agreed to restore the situation that existed before the fighting, which both now describe as a historic achievement."),
    (id: "white_peace_worth", trigger: WhitePeaceAfterWar, surface: OfficialStatement, priority: 2, intensity: Black, max_gravity: 3,
     text: "{actor} and {target} have concluded {turns} quarters of war with a return to the exact pre-war position, proving decisively that the pre-war position was worth fighting for."),
    (id: "white_peace_monument", trigger: WhitePeaceAfterWar, surface: InternalMemo, priority: 2, intensity: Black, max_gravity: 3,
     text: "Territory gained: none. War aims achieved: the continued employment of the people who set the war aims. Commission a monument. Keep the inscription vague."),
    (id: "stayed_out_dry", trigger: GuarantorStayedOut, surface: OfficialStatement, priority: 3, intensity: Dry, max_gravity: 3,
     text: "{actor} continues to honour its guarantee to {target} in spirit. Regrettably, the attack on {target} was conducted in person."),
    (id: "stayed_out_iron", trigger: GuarantorStayedOut, surface: OfficialStatement, priority: 3, intensity: Black, max_gravity: 3,
     text: "{actor}'s commitment to {target} remains ironclad. Iron, metallurgists confirm, is extremely heavy and difficult to move at short notice."),
    (id: "stayed_out_memo", trigger: GuarantorStayedOut, surface: InternalMemo, priority: 3, intensity: Black, max_gravity: 3,
     text: "Yes, we guaranteed {target}. A guarantee is a promise made in peacetime by people who expected peacetime to continue. Draft something about lessons learned. Do not use the word guarantee in it."),
    (id: "sent_sanctions_dry", trigger: GuarantorSentSanctions, surface: OfficialStatement, priority: 3, intensity: Dry, max_gravity: 3,
     text: "In fulfilment of its guarantee to {target}, {actor} has responded with {response}. The guarantee did not specify what it would be fulfilled with."),
    (id: "sent_sanctions_standing", trigger: GuarantorSentSanctions, surface: OfficialStatement, priority: 3, intensity: Black, max_gravity: 3,
     text: "{actor} promised to stand by {target}, and it is standing by {target}: right next to it, watching closely, holding {response}."),
    (id: "sent_sanctions_envelope", trigger: GuarantorSentSanctions, surface: InternalMemo, priority: 3, intensity: Black, max_gravity: 3,
     text: "{target} asked for divisions. We are sending {response}. Technically both are forms of support. Only one of them fits in an envelope."),
    (id: "punitive_dry", trigger: PunitiveStrike, surface: OfficialStatement, priority: 4, intensity: Dry, max_gravity: 3, max_per_campaign: 1,
     text: "{actor} has conducted a measured, proportionate and limited operation against {target}. All three adjectives were approved in advance."),
    (id: "punitive_surgical", trigger: PunitiveStrike, surface: OfficialStatement, priority: 4, intensity: Black, max_gravity: 3, max_per_campaign: 1,
     text: "{actor} reports a precise action against military targets in {target}. The operation was surgical, in the sense that afterwards a great many people in suits stood around congratulating each other."),
    (id: "punitive_message", trigger: PunitiveStrike, surface: InternalMemo, priority: 4, intensity: Black, max_gravity: 3, max_per_campaign: 1,
     text: "Objective of the strike on {target}: send a message. Content of the message: still being drafted. Delivery: confirmed."),
    (id: "war_began_dry", trigger: WarBegan, surface: OfficialStatement, priority: 6, intensity: Dry, max_gravity: 3, max_per_campaign: 2,
     text: "{actor} has regretfully commenced {aim} operations against {target}, in the interests of a peace it intends to define later."),
    (id: "war_began_ministry", trigger: WarBegan, surface: OfficialStatement, priority: 6, intensity: Black, max_gravity: 3, max_per_campaign: 2,
     text: "The Ministry of Peace announces the start of {aim} operations against {target}. The Ministry thanks the nation for its patience during the previous, unsatisfactory peace."),
    (id: "mobilized_dry", trigger: MobilizedAtPeace, surface: OfficialStatement, priority: 4, intensity: Dry, max_per_campaign: 1,
     text: "{actor} has moved to {level} mobilisation as a purely precautionary measure against the possibility of needing it."),
    (id: "mobilized_heavily", trigger: MobilizedAtPeace, surface: OfficialStatement, priority: 4, intensity: Black, max_per_campaign: 1,
     text: "{actor} announces {level} mobilisation in defence of the peace, which has never been more heavily armed."),
    (id: "hollow_dry", trigger: CutMilitarySpendingThenThreatened, surface: OfficialStatement, priority: 2, intensity: Dry, max_gravity: 3,
     text: "{actor} confirms that its armed forces remain fully prepared, at {readiness}% of fully prepared."),
    (id: "hollow_dividend", trigger: CutMilitarySpendingThenThreatened, surface: InternalMemo, priority: 2, intensity: Black, max_gravity: 3,
     text: "We spent the peace dividend. {target} has come to collect the peace. Readiness is {readiness}%, which the Treasury describes as efficient and the General Staff describes using words the Treasury has asked us not to minute."),
    (id: "hollow_official", trigger: CutMilitarySpendingThenThreatened, surface: OfficialStatement, priority: 2, intensity: Black, max_gravity: 3,
     text: "The government notes that its defence reforms, which reduced readiness to a lean {readiness}%, were designed for exactly this kind of situation, and is reviewing what the design was."),
    // ── V3 · Scenario events (G2 unless noted), arms, strategy, epitaph ──
    // The joke is the institution that caused or spun the event. Never the
    // hostages, the protesters, or anyone with less power than the speaker.
    (id: "hostage_guests", trigger: ScenarioEvent, event: Some("hostage_crisis"), surface: OfficialStatement, priority: 4, intensity: Black,
     text: "{actor} confirms that the guests of the revolution remain in good health, and are being detained entirely for their own protection from {target}."),
    (id: "hostage_dry", trigger: ScenarioEvent, event: Some("hostage_crisis"), surface: OfficialStatement, priority: 4, intensity: Dry,
     text: "{actor} describes the continuing detention as a diplomatic conversation that {target} keeps interrupting."),
    (id: "default_savings", trigger: ScenarioEvent, event: Some("debt_default"), surface: TreasuryMemo, priority: 2, intensity: Black,
     text: "The national debt has been cut by forty per cent overnight, by the innovative method of not paying it. Creditors have been invited to share in the savings."),
    (id: "default_dry", trigger: ScenarioEvent, event: Some("debt_default"), surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "{actor} has entered a period of voluntary creditor restructuring, which its creditors describe in less voluntary terms."),
    (id: "protests_enthusiasm", trigger: ScenarioEvent, event: Some("mass_protests"), surface: OfficialStatement, priority: 4, intensity: Black,
     text: "The government of {actor} welcomes the public's enthusiasm for its squares and boulevards, and has deployed additional security forces to help it enjoy them in an orderly fashion."),
    (id: "protests_dry", trigger: ScenarioEvent, event: Some("mass_protests"), surface: OfficialStatement, priority: 4, intensity: Dry,
     text: "The Interior Ministry of {actor} reports that large numbers of citizens have gathered spontaneously to express their support for stability, loudly."),
    (id: "scare_routine", trigger: ScenarioEvent, event: Some("war_scare"), surface: OfficialStatement, priority: 4, intensity: Black,
     text: "{actor} reminds {target} that its exercises near the border are routine, and will remain routine right up until the moment they are not."),
    (id: "scare_pencil", trigger: ScenarioEvent, event: Some("war_scare"), surface: InternalMemo, priority: 4, intensity: Black,
     text: "We and {target} are both running defensive exercises aimed at each other. Analysts call the situation stable, in the sense that a pencil balanced on its point is stable."),
    (id: "border_records", trigger: ScenarioEvent, event: Some("border_incidents"), surface: OfficialStatement, priority: 4, intensity: Black,
     text: "{actor} regrets the incidents on its border with {target}, every one of which was started by {target}, according to the side that keeps the records."),
    (id: "border_dry", trigger: ScenarioEvent, event: Some("border_incidents"), surface: OfficialStatement, priority: 4, intensity: Dry,
     text: "{actor} attributes the recent incidents on its border with {target} to the border."),
    (id: "claim_liberation", trigger: ScenarioEvent, event: Some("diversionary_claim"), surface: OfficialStatement, priority: 2, intensity: Black,
     text: "{actor} has rediscovered its historic claim to territory held by {target}. Unemployment, inflation and the opposition will be addressed after the liberation."),
    (id: "claim_dry", trigger: ScenarioEvent, event: Some("diversionary_claim"), surface: OfficialStatement, priority: 2, intensity: Dry,
     text: "{actor} reminds its citizens that the true cause of their difficulties lies across the border with {target}, approximately."),
    (id: "armed_defensive", trigger: ArmedClient, surface: OfficialStatement, priority: 5, intensity: Dry, max_per_campaign: 2,
     text: "{actor} has delivered defensive equipment to {target}, defined as equipment pointed away from {actor}."),
    (id: "armed_problem", trigger: ArmedClient, surface: InternalMemo, priority: 5, intensity: Black, max_per_campaign: 2,
     text: "Arms to {target} approved at {amount} a quarter. Their gratitude is assessed as reliable for about five years, after which the equipment becomes somebody else's problem, quite possibly ours."),
    (id: "reversed_memoryhole", trigger: StrategyReversed, surface: OfficialStatement, priority: 1, intensity: Black, max_per_campaign: 2,
     text: "{actor} has always pursued {new}. Reports that it ever pursued {old} are being corrected, and will always have been correct."),
    (id: "reversed_dry", trigger: StrategyReversed, surface: OfficialStatement, priority: 1, intensity: Dry, max_per_campaign: 2,
     text: "{actor} has updated its strategic priorities to {new}. The previous priorities ({old}) were a transitional phase lasting a generation."),
    (id: "epitaph_resolve", trigger: Epitaph, surface: OfficialStatement, priority: 6, intensity: Black,
     text: "{actor} met {years} years of challenges with unbroken resolve. Every commitment it honoured, it honoured magnificently. The ones it abandoned (total: {abandoned}) were not commitments in the sense intended. The economy grew by {growth} per cent, which the Ministry attributes to the Ministry."),
    (id: "epitaph_writing", trigger: Epitaph, surface: OfficialStatement, priority: 6, intensity: Black,
     text: "History will record that {actor} was always right, because {actor} is writing it. The so-called Ledger, which lists {honoured} promises kept and {abandoned} abandoned, is a foreign publication and has been withdrawn from libraries."),
    (id: "epitaph_dry", trigger: Epitaph, surface: OfficialStatement, priority: 6, intensity: Dry,
     text: "Over {years} years {actor} honoured {honoured} commitments, with minor exceptions totalling {abandoned}."),
    // ── P10 · Covert programmes (G2; the use of weapons is never joked about) ──
    (id: "exposed_fertiliser", trigger: ProgrammeExposed, surface: OfficialStatement, priority: 1, intensity: Black,
     text: "{actor} confirms that the facility photographed by {target} is a fertiliser plant, which explains the reinforced concrete, the centrifuges and the guards, as fertiliser is extremely valuable."),
    (id: "exposed_dry", trigger: ProgrammeExposed, surface: OfficialStatement, priority: 1, intensity: Dry,
     text: "{actor} has no weapons programme, and will be dismantling it shortly."),
    (id: "declared_ambiguity", trigger: ArsenalDeclared, surface: InternalMemo, priority: 4, intensity: Black,
     text: "For years the policy was that we neither confirm nor deny. We have now confirmed. The departments that existed solely to deny have been told to find something else to deny."),
    (id: "declared_dry", trigger: ArsenalDeclared, surface: OfficialStatement, priority: 4, intensity: Dry,
     text: "{actor} announces that the weapons it never had are now available for deterrence."),
    (id: "dismantled_virtue", trigger: ArsenalDismantled, surface: OfficialStatement, priority: 5, intensity: Black,
     text: "{actor} has voluntarily given up its nuclear weapons, a decision taken freely and without pressure at the exact moment keeping them stopped being worth the sanctions."),
    (id: "dismantled_dry", trigger: ArsenalDismantled, surface: OfficialStatement, priority: 5, intensity: Dry,
     text: "{actor} has disclosed and dismantled an arsenal whose existence it had not previously mentioned."),
    // ── P2 · Secession (G2; the joke is the centre, never the region or its people) ──
    (id: "secession_unbreakable", trigger: Secession, surface: OfficialStatement, priority: 1, intensity: Black, max_per_campaign: 2,
     text: "{actor} reaffirms that the union is unbreakable and eternal, and notes that {target} has temporarily chosen to be eternal somewhere else."),
    (id: "secession_memo", trigger: Secession, surface: InternalMemo, priority: 1, intensity: Black, max_per_campaign: 2,
     text: "{target} has left. The map department asks whether to redraw the borders or to keep printing the old ones until the situation corrects itself. Advise the second. It is cheaper and has worked before."),
    (id: "secession_dry", trigger: Secession, surface: OfficialStatement, priority: 1, intensity: Dry, max_per_campaign: 2,
     text: "{actor} regrets the administrative misunderstanding with {target}, which now has its own administration."),
]
