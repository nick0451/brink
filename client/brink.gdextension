[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

; Both point at the release build: the AI turn loop is slow unoptimised.
[libraries]
windows.debug.x86_64 = "res://../target/release/brink_godot.dll"
windows.release.x86_64 = "res://../target/release/brink_godot.dll"
